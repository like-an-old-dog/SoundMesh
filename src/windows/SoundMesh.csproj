<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <Version>1.2.1</Version><ApplicationIcon>SoundMesh.ico</ApplicationIcon><AssemblyName>SoundMesh</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="NAudio" Version="2.2.1" /><PackageReference Include="ZXing.Net" Version="0.16.11" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="SoundMesh.ico" LogicalName="Brand.Icon" />
    <EmbeddedResource Include="../brand/wave.png" LogicalName="Brand.Wave" />
    <EmbeddedResource Include="../brand/mark.png" LogicalName="Brand.Mark" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="../iphone-web/web/*" LogicalName="Web.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
